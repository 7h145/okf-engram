{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failed-log triage review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "summary",
    "firstCausalLine",
    "likelyOwner",
    "hypotheses",
    "focusedCommand",
    "requiresStrongerReview",
    "uncertainty"
  ],
  "properties": {
    "classification": {
      "enum": [
        "test-assertion",
        "runtime-compatibility",
        "dependency",
        "environment",
        "timeout",
        "output-overflow",
        "product-defect",
        "test-defect",
        "unknown"
      ]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "firstCausalLine": { "type": ["integer", "null"], "minimum": 1 },
    "likelyOwner": { "type": ["string", "null"], "maxLength": 300 },
    "hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "confidence", "evidenceLines"],
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "evidenceLines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "focusedCommand": { "type": ["string", "null"], "maxLength": 500 },
    "requiresStrongerReview": { "type": "boolean" },
    "uncertainty": { "type": "string", "maxLength": 500 }
  }
}
